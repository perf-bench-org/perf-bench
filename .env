# Адрес модели. ЕДИНСТВЕННОЕ место, где он задаётся: отсюда его берут оба compose-проекта.
#
#   docker-compose.yml                  -> LT_TARGET_URL и LT_VLLM_BASEURL контейнера loadtest
#   metrics-storage/docker-compose.yml  -> %{VLLM_HOST} и %{VLLM_PORT} в vmagent-config.yml
#
# Значения target.url и vllm.baseUrl в config/test.properties этим перебиваются всегда —
# править их бессмысленно, правьте адрес здесь.
#
# --- VLLM_HOST ---
#
# Имя, по которому контейнеры стенда ходят до модели. Два рабочих значения:
#
#   vllm             модель НЕ в сети loadtest-net: на хосте вне докера либо в докере с портом,
#                    опубликованным на 0.0.0.0. Имя резолвится в шлюз хоста через
#                    extra_hosts: "vllm:host-gateway" в обоих compose-файлах.
#
#   <имя контейнера> модель в докере и подключена к loadtest-net. Запись extra_hosts при этом
#                    просто перестаёт использоваться — удалять её не нужно. Менять имя
#                    ОБЯЗАТЕЛЬНО: extra_hosts попадает в /etc/hosts контейнера и перебивает
#                    docker DNS, поэтому контейнер с именем vllm в общей сети недоступен.
#
# Случай, который не лечится ничем: порт, опубликованный только на 127.0.0.1. Из контейнера
# такой адрес недостижим в принципе — публикуйте на 0.0.0.0.
VLLM_HOST=vllm

# Порт, на котором vLLM отдаёт /v1 и /metrics.
VLLM_PORT=40001
